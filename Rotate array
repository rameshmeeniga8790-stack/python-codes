from typing import List

class Solution:
    def rotate(self, nums: List[int], k: int) -> None:
        """
        Rotates the array to the right by k steps in-place using the reversal method.
        """
        n = len(nums)
        # Normalize k to handle cases where k is greater than the array length
        k %= n

        if k == 0:
            return

        def reverse(start: int, end: int) -> None:
            """Helper function to reverse elements within a specific range."""
            while start < end:
                nums[start], nums[end] = nums[end], nums[start]
                start += 1
                end -= 1

        # 1. Reverse the entire array
        # Example: [1, 2, 3, 4, 5, 6, 7], k=3 -> [7, 6, 5, 4, 3, 2, 1]
        reverse(0, n - 1)

        # 2. Reverse the first k elements
        # Example: [7, 6, 5, 4, 3, 2, 1] -> [5, 6, 7, 4, 3, 2, 1]
        reverse(0, k - 1)

        # 3. Reverse the remaining n-k elements
        # Example: [5, 6, 7, 4, 3, 2, 1] -> [5, 6, 7, 1, 2, 3, 4]
        reverse(k, n - 1)

# Example Usage:
nums1 = [1, 2, 3, 4, 5, 6, 7]
k1 = 3
Solution().rotate(nums1, k1)
print(f"Rotated array 1: {nums1}") # Output: [5, 6, 7, 1, 2, 3, 4]

nums2 = [-1, -100, 3, 99]
k2 = 2
Solution().rotate(nums2, k2)
print(f"Rotated array 2: {nums2}") # Output: [3, 99, -1, -100]
