class Solution:
    def romanToInt(self, s: str) -> int:
        """
        Converts a Roman numeral string to its integer equivalent.
        
        :param s: A string representing a Roman numeral.
        :return: The integer value of the Roman numeral.
        """
        # Mapping of Roman numerals to integer values
        roman_map = {
            'I': 1,
            'V': 5,
            'X': 10,
            'L': 50,
            'C': 100,
            'D': 500,
            'M': 1000
        }
        
        total = 0
        n = len(s)
        i = 0
        
        while i < n:
            # Check for the subtractive case (e.g., IV, IX, etc.)
            # If the current value is less than the next, it's a subtractive pair.
            if i + 1 < n and roman_map[s[i]] < roman_map[s[i+1]]:
                total += roman_map[s[i+1]] - roman_map[s[i]]
                i += 2  # Skip both characters as they were processed as a pair
            else:
                # Otherwise, just add the current character's value
                total += roman_map[s[i]]
                i += 1  # Move to the next character
                
        return total

